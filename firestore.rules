rules_version = '2';
// Ortunç CRM — rol bazlı güvenlik kuralları
// Roller: yonetici (her şey) · satis (kayıt ekler/düzenler) · onburo (misafir, görev, aktivite) · izleyici (yalnızca okur)
service cloud.firestore {
  match /databases/{database}/documents {

    function uid() { return request.auth.uid; }
    function hasUser() { return request.auth != null && exists(/databases/$(database)/documents/users/$(uid())); }
    function me() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function signed() { return hasUser() && me().active == true; }
    function isAdmin() { return signed() && me().role == 'yonetici'; }
    function canSales() { return signed() && me().role in ['yonetici', 'satis']; }
    function canDesk() { return signed() && me().role in ['yonetici', 'satis', 'onburo']; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // Kurulum işareti: yalnızca bir kez, ilk yönetici oluşturulurken yazılır
    match /meta/setup {
      allow read: if true;
      allow create: if request.auth != null && !setupDone();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signed() || (request.auth != null && uid() == userId);
      // İlk yönetici kendi kaydını açar; sonrasında yalnızca yönetici kullanıcı ekler
      allow create: if (request.auth != null && uid() == userId && !setupDone()
                        && request.resource.data.role == 'yonetici')
                    || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin() && uid() != userId;
    }

    match /settings/{docId} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    match /accounts/{id} {
      allow read: if signed();
      allow create, update: if canSales();
      allow delete: if isAdmin();
    }
    match /opps/{id} {
      allow read: if signed();
      allow create, update: if canSales();
      allow delete: if isAdmin();
    }
    match /weddings/{id} {
      allow read: if signed();
      allow create, update: if canSales();
      allow delete: if isAdmin();
    }
    match /guests/{id} {
      allow read: if signed();
      allow create, update: if canDesk();
      allow delete: if isAdmin();
    }
    match /activities/{id} {
      allow read: if signed();
      allow create: if canDesk() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin() || (canDesk() && resource.data.userId == uid());
    }
    // Belgeler: üst bilgi + 1 MB'lık parçalar
    match /files/{id} {
      allow read: if signed();
      allow create: if canSales() && request.resource.data.uploadedBy == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (canSales() && resource.data.uploadedBy == uid());
    }
    match /fileChunks/{id} {
      allow read: if signed();
      allow create: if canSales() && request.resource.data.uploadedBy == uid();
      allow update: if false;
      allow delete: if isAdmin() || (canSales() && resource.data.uploadedBy == uid());
    }
    match /blacklist/{id} {
      allow read: if signed();
      allow create, update: if canDesk();
      allow delete: if isAdmin();
    }
    match /reports/{id} {
      allow read: if signed();
      allow create, update: if canDesk();
      allow delete: if isAdmin() || (canDesk() && resource.data.createdBy == uid());
    }
    match /targets/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }
    match /rates/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }
    match /blocks/{id} {
      allow read: if signed();
      allow create, update: if canSales();
      allow delete: if isAdmin() || (canSales() && resource.data.createdBy == uid());
    }
    match /visits/{id} {
      allow read: if signed();
      allow create, update: if canSales();
      allow delete: if isAdmin() || (canSales() && resource.data.createdBy == uid());
    }
    match /tasks/{id} {
      allow read: if signed();
      allow create, update: if canDesk();
      allow delete: if isAdmin() || (canDesk() && resource.data.createdBy == uid());
    }
  }
}
